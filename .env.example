# ---------------------------------------------------------------
# Cozinhei — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com as credenciais do seu projeto
# no Supabase. O `.env` é ignorado pelo git (ver .gitignore).
#
# Sem estas duas variáveis o aplicativo roda em MODO LOCAL: tudo funciona
# contra o SQLite do aparelho, exatamente como na etapa 04. Com elas, entra em
# MODO CONECTADO e passa a falar com o backend.
#
# O prefixo EXPO_PUBLIC_ é obrigatório para a variável chegar ao aplicativo, e
# significa que ela VAI PARA O BUNDLE. Por isso aqui só entra a chave `anon`,
# que é pública por projeto — nunca a `service_role`, que ignora as políticas
# de segurança do banco.
# ---------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
