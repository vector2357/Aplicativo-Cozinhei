{
  "expo": {
    "name": "Cozinhei",
    "slug": "cozinhei",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "cozinhei",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F2F3F0",
    "splash": {
      "backgroundColor": "#12211C",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.cozinhei.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ]
      }
    },
    "android": {
      "package": "br.com.cozinhei.app",
      "adaptiveIcon": {
        "backgroundColor": "#12211C"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12211C",
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
